{
  "name": "opencode-mem",
  "version": "2.28.3",
  "description": "Persistent local memory for coding agents (OpenCode plugin + MCP + standalone runtime) using Turso/libSQL vector search",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "bin": {
    "opencode-mem": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./server": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./v2": {
      "import": "./dist/v2/plugin.js",
      "types": "./dist/v2/plugin.d.ts"
    },
    "./tags": {
      "import": "./dist/memory/tags.js",
      "types": "./dist/memory/tags.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc && bun run web:build && chmod +x dist/cli/index.js",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "dev": "tsc --watch",
    "serve": "bun run src/cli/index.ts serve",
    "mcp": "bun run src/cli/index.ts mcp",
    "install:ides": "bun run src/cli/index.ts install",
    "status": "bun run src/cli/index.ts status",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "vector-database",
    "ai",
    "coding-agent",
    "local",
    "standalone",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude-code",
    "codex"
  ],
  "author": "opencode-mem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tickernelz/opencode-mem.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opencode-ai/plugin": "^1.18.34",
    "@opencode-ai/sdk": "^1.18.34",
    "@opencode/plugin": "^2.0.21",
    "@tursodatabase/database": "^0.8.1",
    "franc-min": "^6.2.0",
    "iso-639-3": "^3.0.1",
    "onnxruntime-node": "1.30.0",
    "zod": "^4.6.5"
  },
  "//": "Pin latest stable onnxruntime-node@1.30.0 (direct + override) with @huggingface/transformers: nested OpenCode installs ignore package overrides (#184); Ort::Env teardown fix shipped in 1.24.1 (#225). Intel Mac (darwin/x64) is unsupported — @tursodatabase/database and fixed onnxruntime releases ship no x64 binding.",
  "overrides": {
    "onnxruntime-node": "1.30.0",
    "bun-types": "1.3.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "chat.params",
      "event"
    ]
  },
  "files": [
    "dist",
    "docs",
    "package.json"
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.svelte": [
      "prettier --write"
    ],
    "*.{css,html,json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
