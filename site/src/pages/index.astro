---
import Landing from "../layouts/Landing.astro";
import Closing from "../components/landing/Closing.astro";
import Contrast from "../components/landing/Contrast.astro";
import Dream from "../components/landing/Dream.astro";
import Faq from "../components/landing/Faq.astro";
import Features from "../components/landing/Features.astro";
import Hero from "../components/landing/Hero.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import Nav from "../components/landing/Nav.astro";
import Nested from "../components/landing/Nested.astro";
import Privacy from "../components/landing/Privacy.astro";
import Proof from "../components/landing/Proof.astro";
import Showcase from "../components/landing/Showcase.astro";
import { en as copy } from "../i18n/en";
---

<Landing copy={copy} lang="en">
  <Nav copy={copy} />
  <main id="main">
    <Hero copy={copy} />
    <Contrast copy={copy} />
    <HowItWorks copy={copy} />
    <Features copy={copy} />
    <Dream copy={copy} />
    <Nested copy={copy} />
    <Showcase copy={copy} />
    <Privacy copy={copy} />
    <Proof copy={copy} />
    <Faq copy={copy} />
  </main>
  <Closing copy={copy} />
</Landing>

<script>
  import "../scripts/landing";
</script>
