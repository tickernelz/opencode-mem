---
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import "../generated/tokens.css";
import "../styles/fonts.css";
import "../styles/landing.css";
import numbers from "../data/numbers.json";
import type { Copy } from "../i18n/en";

interface Props {
  copy: Copy;
  lang: string;
}

const { copy, lang } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "opencode-mem",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, Windows, macOS (Apple Silicon)",
  softwareVersion: numbers.version,
  license: "https://opensource.org/licenses/MIT",
  url: Astro.site?.href,
  description: copy.meta.description,
  image: new URL("/og.png", Astro.site).href,
  downloadUrl: "https://www.npmjs.com/package/opencode-mem",
  sameAs: ["https://github.com/tickernelz/opencode-mem", "https://www.npmjs.com/package/opencode-mem"],
  author: { "@type": "Person", name: "Zhafron Adani Kautsar", url: "https://github.com/tickernelz" },
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f4f8" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="opencode-mem" />
    <meta property="og:locale" content={lang} />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={copy.meta.ogImageAlt} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("starlight-theme");
        const theme = stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
