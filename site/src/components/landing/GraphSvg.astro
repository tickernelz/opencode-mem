---
import type { MemoryGraph } from "../../lib/constellation";

interface Props {
  graph: MemoryGraph;
  focus?: string;
  class?: string;
  fit?: "slice" | "meet";
}

const { graph, focus, class: className, fit = "slice" } = Astro.props;
const focusIndex = focus ? graph.nodes.findIndex((node) => node.label === focus) : -1;
---

<svg
  class:list={["graph-svg", className]}
  viewBox={`0 0 ${graph.width} ${graph.height}`}
  preserveAspectRatio={`xMidYMid ${fit}`}
  aria-hidden="true"
  focusable="false"
>
  <g class="graph-svg__edges">
    {
      graph.edges.map(([a, b]) => (
        <line x1={graph.nodes[a]!.x} y1={graph.nodes[a]!.y} x2={graph.nodes[b]!.x} y2={graph.nodes[b]!.y} />
      ))
    }
  </g>
  <g class="graph-svg__nodes">
    {
      graph.nodes.map((node, i) => (
        <circle
          cx={node.x}
          cy={node.y}
          r={(node.r * (0.7 + node.z * 0.5)).toFixed(2)}
          class:list={{ "is-focus": i === focusIndex }}
          style={`opacity:${(0.4 + node.z * 0.45).toFixed(2)}`}
        />
      ))
    }
  </g>
</svg>
