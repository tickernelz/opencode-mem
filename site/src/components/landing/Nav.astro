---
import type { Copy } from "../../i18n/en";
import numbers from "../../data/numbers.json";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const stars = new Intl.NumberFormat("en").format(numbers.stars);
---

<a class="skip" href="#main">{copy.nav.skip}</a>
<header class="nav">
  <div class="nav__inner wrap">
    <a class="wordmark" href="/" aria-label="opencode-mem home">
      <svg viewBox="-2 -2 28 28" aria-hidden="true" focusable="false">
        <path d="M12 18V5" /><path d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4" /><path
          d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5"
        /><path d="M17.997 5.125a4 4 0 0 1 2.526 5.77" /><path d="M18 18a4 4 0 0 0 2-7.464" /><path
          d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517"
        /><path d="M6 18a4 4 0 0 1-2-7.464" /><path d="M6.003 5.125a4 4 0 0 0-2.526 5.77" />
      </svg>
      <span>opencode-mem</span>
    </a>
    <nav class="nav__links" aria-label="Main">
      <a class="nav__optional" href="#how">{copy.nav.how}</a>
      <a class="nav__optional" href="#features">{copy.nav.features}</a>
      <a class="nav__optional" href="#faq">{copy.nav.faq}</a>
      <a href="/docs/">{copy.nav.docs}</a>
      <a class="nav__gh" href="https://github.com/tickernelz/opencode-mem">
        <span>{copy.nav.github}</span>
        <span class="nav__count" aria-label={`${stars} stars`}>{stars}</span>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={copy.nav.theme}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("starlight-theme", next);
  });
</script>
